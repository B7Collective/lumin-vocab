{
  "id": "/",
  "name": "Lumin Vocab",
  "short_name": "Lumin Vocab",
  "description": "A bigger vocabulary, one beautiful word at a time, for the whole family. Free, private, and open source. Made by B7 Collective.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#EEF2F4",
  "theme_color": "#EEF2F4",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "education",
    "kids",
    "books"
  ],
  "icons": [
    {
      "src": "/icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Review",
      "url": "/#/review",
      "icons": [
        {
          "src": "/icons/app-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Saved words",
      "url": "/#/saved",
      "icons": [
        {
          "src": "/icons/app-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/icons/screenshot-wide.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The word feed on a computer"
    },
    {
      "src": "/icons/screenshot-phone.jpg",
      "sizes": "390x844",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "The word feed on a phone"
    }
  ]
}
